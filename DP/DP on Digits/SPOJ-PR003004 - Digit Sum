const int MAX = 2e5 + 5;
const int MOD = 1e9+7;

ll add(ll a, ll b) {
    return ((a % MOD) + (b % MOD)) % MOD;
}
ll sub(ll a, ll b) {
    return ((a % MOD) - (b % MOD) + MOD) % MOD;
}
vector<pair<int, int>>prime_factors;
void factorize(int n) {
    for (int i = 2; i * i <= n; i++) {
        int power = 0;
        while (n % i == 0) {
            power++;
            n /= i;
        }
        if (power) {
            prime_factors.push_back({ i,power });
        }
    }
    if (n != 1) {
        prime_factors.push_back({ n,1 });
    }
}
//__builtin_popcount(mask)
string s;
ll dp[20][150][2]; //16*9=144
// u may use one of the states as the result
ll solve(int idx = 0,int prev=0, bool tight = true) {
    if (idx == s.size())
        return prev;

    if (dp[idx][prev][tight] != -1)
        return dp[idx][prev][tight];

    dp[idx][prev][tight] = 0;
    int end = tight ? s[idx] - '0' : 9;
    for (int i = 0; i <= end; i++) {
        dp[idx][prev][tight] += solve(idx + 1, prev+i,tight && (i == end));
    }
   
    return dp[idx][prev][tight];
}
